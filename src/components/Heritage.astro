---
// Heritage strip: the real history + count-up stats (all real facts from the current site).
import { business, history, delivery } from "../data/site";
import Photo from "./Photo.astro";
interface Props { showStats?: boolean; headingLevel?: "h1" | "h2" }
const { showStats = true } = Astro.props;
const years = new Date().getFullYear() - business.since;
const townCount = Object.values(delivery.towns).flat().length;
const stats = [
  { value: years, suffix: "", label: `Years serving New Jersey (since ${business.since})` },
  { value: business.counties.length, suffix: "", label: "Counties on our delivery route" },
  { value: townCount, suffix: "", label: "Towns on our delivery list" },
  { value: 24, suffix: "-hr", label: "Emergency ice delivery" },
];
---
<section class="bg-frost py-16 md:py-24" aria-labelledby="heritage-h">
  <div class="wrap grid items-start gap-10 lg:grid-cols-2 lg:gap-16">
    <figure data-reveal>
      <Photo name="real-delivery-truck.jpg" alt="An Esposito's Ice delivery truck parked by the Esposito's Ice sign" widths={[551]} sizes="(min-width: 1024px) 50vw, 100vw" class="w-full rounded-md object-cover" />
      <figcaption class="mt-3 text-sm text-muted">Our truck at {business.address.street}, {business.address.city}.</figcaption>
    </figure>
    <div>
      <div data-reveal>
        <span class="kicker-rule"></span>
        <h2 id="heritage-h" class="text-4xl font-bold md:text-5xl">A family ice house since {business.since}</h2>
      </div>
      <ol class="mt-8 space-y-7">
        {history.map((h, i) => (
          <li class="grid grid-cols-[5.5rem_1fr] gap-4" data-reveal style={`--i:${i}`}>
            <span class="font-display text-2xl font-bold text-green">{h.year}</span>
            <div class="border-l-2 border-tan pl-4">
              <h3 class="text-xl font-bold">{h.title}</h3>
              <p class="mt-1 text-muted">{h.text}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </div>
  {showStats && (
    <div class="wrap mt-14">
      <dl class="grid grid-cols-2 gap-6 border-t border-line pt-10 lg:grid-cols-4">
        {stats.map((s, i) => (
          <div class="flex flex-col" data-reveal style={`--i:${i}`}>
            <dt class="order-2 mt-1 text-muted">{s.label}</dt>
            <dd class="order-1 font-display text-5xl font-bold text-green md:text-6xl"><span data-count={s.value}>{s.value}</span>{s.suffix}</dd>
          </div>
        ))}
      </dl>
    </div>
  )}
</section>
