---
// Chat assistant widget (demo). Only rendered when chatbot.enabled is true (see Base.astro).
// - Floating button, bottom right. On phones it sits above the call bar and the panel is full screen.
// - Answers come from /api/chat (a Netlify Function). Model text is shown as PLAIN TEXT only.
// - The lead form is a Netlify Form named "chat-lead"; it is plain HTML here so Netlify can find it.
import { business, chatbot } from "../data/site";
const lead = chatbot.leadForm;
---
<div class="chat" data-chat
  data-endpoint={chatbot.endpoint}
  data-phone-display={business.phone.display}
  data-phone-tel={business.phone.tel}
  data-quote-path="/contact-us/#quote"
  data-max-user-messages={chatbot.maxUserMessages}
  data-greeting={chatbot.greeting}>

  <button type="button" class="chat-fab btn btn-primary" data-chat-open aria-haspopup="dialog" aria-expanded="false" aria-controls="chat-panel">
    <svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true" fill="currentColor"><path d="M4 4h16a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H9l-5 4v-4a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2z"/></svg>
    <span>{chatbot.title}</span>
  </button>

  <div class="chat-panel" id="chat-panel" role="dialog" aria-modal="true" aria-labelledby="chat-title" hidden data-chat-panel>
    <header class="chat-head">
      <h2 id="chat-title" class="font-display text-xl font-bold">{chatbot.title}</h2>
      <button type="button" class="chat-close" data-chat-close aria-label="Close chat">
        <svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"/></svg>
      </button>
    </header>

    <div class="chat-body" data-chat-main>
      <div class="chat-log" role="log" aria-live="polite" aria-label="Conversation" data-chat-log tabindex="0"></div>
      <div class="chat-chips" data-chat-chips>
        {chatbot.suggestions.map((s) => <button type="button" class="chat-chip" data-chat-suggest>{s}</button>)}
      </div>
      <form class="chat-input" data-chat-form autocomplete="off">
        <label for="chat-text" class="sr-only">Your message</label>
        <input id="chat-text" type="text" maxlength={chatbot.maxMessageChars} placeholder="Type your question…" enterkeyhint="send" data-chat-text />
        <button type="submit" class="btn btn-primary chat-send" data-chat-send>Send</button>
      </form>
      <div class="chat-foot">
        <p>{chatbot.privacyNotice}</p>
        <button type="button" class="chat-linkbtn" data-chat-lead-open>{lead.button}</button>
      </div>
    </div>

    <!-- Lead form. Static HTML so Netlify Forms detects "chat-lead" at build time. -->
    <div class="chat-lead" data-chat-lead hidden>
      <form name={lead.name} method="POST" data-netlify="true" netlify-honeypot="bot-field" novalidate data-lead-form>
        <input type="hidden" name="form-name" value={lead.name} />
        <p class="hidden"><label>Leave this empty: <input name="bot-field" tabindex="-1" autocomplete="off" /></label></p>
        <h3 class="font-display text-lg font-bold">{lead.button}</h3>
        <p class="chat-small">Leave your details and the Esposito's team will get back to you. Please give a phone number or an email.</p>
        <div class="chat-field"><label for="lead-name">Name <span aria-hidden="true">*</span></label><input id="lead-name" name="name" type="text" autocomplete="name" required /></div>
        <div class="chat-field"><label for="lead-phone">Phone</label><input id="lead-phone" name="phone" type="tel" inputmode="tel" autocomplete="tel" /></div>
        <div class="chat-field"><label for="lead-email">Email</label><input id="lead-email" name="email" type="email" autocomplete="email" /></div>
        <div class="chat-field"><label for="lead-date">Event date <span class="chat-opt">(optional)</span></label><input id="lead-date" name="event_date" type="date" /></div>
        <div class="chat-field"><label for="lead-need">What do you need?</label>
          <select id="lead-need" name="need"><option value="">Choose one</option>{lead.needOptions.map((o) => <option value={o}>{o}</option>)}</select>
        </div>
        <div class="chat-field"><label for="lead-details">Details <span class="chat-opt">(optional)</span></label><textarea id="lead-details" name="details" rows="3" maxlength="500"></textarea></div>
        <p class="chat-small">{chatbot.privacyNotice}</p>
        <p class="chat-error" role="alert" data-lead-error></p>
        <div class="chat-lead-actions">
          <button type="submit" class="btn btn-primary" data-lead-submit>Send</button>
          <button type="button" class="btn btn-outline" data-lead-back>Back to chat</button>
        </div>
      </form>
      <div class="chat-lead-done" hidden tabindex="-1" data-lead-done>
        <p class="font-display text-xl font-bold text-green">Request sent</p>
        <p class="mt-2">Thanks! The team will follow up. For anything urgent, call <a href={`tel:${business.phone.tel}`}>{business.phone.display}</a>.</p>
        <button type="button" class="btn btn-primary mt-4" data-lead-back>Back to chat</button>
      </div>
    </div>
  </div>
</div>

<style is:global>
  .chat { font-family: var(--font-sans); font-size: 1rem; line-height: 1.5; color: var(--color-ink); }
  .chat-fab {
    position: fixed; z-index: 60; right: 1rem;
    bottom: calc(72px + env(safe-area-inset-bottom) + 12px);
    border-radius: 999px; box-shadow: 0 10px 30px -10px rgb(20 35 27 / 0.6);
  }
  .chat-panel {
    position: fixed; z-index: 60; inset: 0; display: flex; flex-direction: column;
    background: var(--color-white); overflow: hidden;
  }
  .chat-panel[hidden], .chat [hidden] { display: none !important; }
  .chat-head { display: flex; align-items: center; justify-content: space-between; padding: 0.75rem 1rem; background: var(--color-green); color: var(--color-white); }
  .chat-close { display: inline-flex; align-items: center; justify-content: center; width: 44px; height: 44px; border-radius: 8px; color: inherit; background: transparent; }
  .chat-close:hover { background: rgb(255 255 255 / 0.15); }
  .chat button:focus-visible, .chat input:focus-visible, .chat select:focus-visible, .chat textarea:focus-visible, .chat a:focus-visible, .chat [tabindex]:focus-visible { outline: 3px solid var(--color-green); outline-offset: 2px; }
  .chat-head .chat-close:focus-visible { outline-color: var(--color-white); }
  .chat-body { display: flex; flex: 1; min-height: 0; flex-direction: column; background: var(--color-frost); }
  .chat-log { flex: 1; overflow-y: auto; padding: 1rem; display: flex; flex-direction: column; gap: 0.6rem; }
  .chat-msg { max-width: 88%; padding: 0.6rem 0.85rem; border-radius: 8px; white-space: pre-wrap; overflow-wrap: anywhere; }
  .chat-msg.bot { align-self: flex-start; background: var(--color-white); border: 1px solid var(--color-line); }
  .chat-msg.me { align-self: flex-end; background: var(--color-green); color: var(--color-white); }
  .chat-msg a { color: var(--color-green); font-weight: 600; }
  .chat-msg.me a { color: var(--color-white); }
  .chat-cta { align-self: flex-start; }
  .chat-chips { display: flex; flex-wrap: wrap; gap: 0.5rem; padding: 0 1rem 0.75rem; }
  .chat-chip { min-height: 44px; padding: 0.4rem 0.85rem; border-radius: 999px; background: var(--color-white); box-shadow: inset 0 0 0 2px var(--color-green); color: var(--color-green); font-weight: 600; }
  .chat-input { display: flex; gap: 0.5rem; padding: 0.75rem 1rem; background: var(--color-white); border-top: 1px solid var(--color-line); }
  .chat-input input { flex: 1; min-width: 0; min-height: 48px; padding: 0.6rem 0.85rem; font-size: 1rem; border: 1.5px solid #8a978f; border-radius: 8px; }
  .chat-foot { padding: 0.6rem 1rem calc(0.6rem + env(safe-area-inset-bottom)); background: var(--color-white); font-size: 0.8125rem; color: var(--color-muted); display: flex; flex-direction: column; gap: 0.35rem; }
  .chat-linkbtn { align-self: flex-start; min-height: 44px; font-weight: 700; color: var(--color-green); text-decoration: underline; text-underline-offset: 3px; background: transparent; }
  .chat-lead { flex: 1; overflow-y: auto; padding: 1rem; background: var(--color-frost); }
  .chat-lead form { display: grid; gap: 0.75rem; }
  .chat-field { display: grid; gap: 0.3rem; }
  .chat-field label { font-weight: 600; }
  .chat-field input, .chat-field select, .chat-field textarea { width: 100%; min-height: 48px; padding: 0.6rem 0.8rem; font-size: 1rem; border: 1.5px solid #8a978f; border-radius: 8px; background: #fff; color: var(--color-ink); }
  .chat-field textarea { min-height: 5.5rem; }
  .chat-opt { font-weight: 400; color: var(--color-muted); }
  .chat-small { font-size: 0.875rem; color: var(--color-muted); }
  .chat-error { color: #a3261b; font-weight: 600; }
  .chat-lead-actions { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .chat-lead-done { padding: 0.5rem 0; }
  .chat-typing { color: var(--color-muted); font-style: italic; }
  @media (min-width: 1024px) {
    .chat-fab { bottom: 1.5rem; right: 1.5rem; }
    .chat-panel { inset: auto 1.5rem 1.5rem auto; width: 24rem; height: min(36rem, calc(100vh - 3rem)); border-radius: 12px; box-shadow: 0 24px 60px -20px rgb(20 35 27 / 0.55); }
  }
  @media (prefers-reduced-motion: no-preference) {
    .chat-panel:not([hidden]) { animation: chat-in 0.22s var(--ease-out); }
    @keyframes chat-in { from { opacity: 0; transform: translateY(12px); } to { opacity: 1; transform: none; } }
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>("[data-chat]");
  if (root) {
    const $ = <T extends HTMLElement>(sel: string) => root.querySelector<T>(sel)!;
    const fab = $<HTMLButtonElement>("[data-chat-open]");
    const panel = $<HTMLElement>("[data-chat-panel]");
    const log = $<HTMLElement>("[data-chat-log]");
    const chips = $<HTMLElement>("[data-chat-chips]");
    const form = $<HTMLFormElement>("[data-chat-form]");
    const text = $<HTMLInputElement>("[data-chat-text]");
    const sendBtn = $<HTMLButtonElement>("[data-chat-send]");
    const main = $<HTMLElement>("[data-chat-main]");
    const leadBox = $<HTMLElement>("[data-chat-lead]");
    const leadForm = $<HTMLFormElement>("[data-lead-form]");
    const leadDone = $<HTMLElement>("[data-lead-done]");
    const leadError = $<HTMLElement>("[data-lead-error]");
    const leadSubmit = $<HTMLButtonElement>("[data-lead-submit]");

    const d = root.dataset;
    const phoneDisplay = d.phoneDisplay!;
    const phoneTel = d.phoneTel!;
    const quotePath = d.quotePath!;
    const maxUser = Number(d.maxUserMessages);
    // The conversation lives only in this page's memory. Nothing is saved in the browser.
    const history: { role: "user" | "assistant"; content: string }[] = [];
    let busy = false;
    let greeted = false;

    // ---- Model text is shown as PLAIN TEXT. Only the phone number and the quote path become links. ----
    const esc = (s: string) => s.replace(/[.*+?^${}()|[\]\\]/g, "\\$&");
    const linkRe = new RegExp(`(${esc(phoneDisplay)}|${esc(quotePath)})`, "g");
    function addText(parent: HTMLElement, s: string) {
      let last = 0;
      for (const m of s.matchAll(linkRe)) {
        if (m.index! > last) parent.append(document.createTextNode(s.slice(last, m.index)));
        const a = document.createElement("a");
        a.textContent = m[0];
        a.href = m[0] === phoneDisplay ? `tel:${phoneTel}` : quotePath;
        parent.append(a);
        last = m.index! + m[0].length;
      }
      if (last < s.length) parent.append(document.createTextNode(s.slice(last)));
    }
    function addMessage(who: "bot" | "me", s: string, cls = "") {
      const el = document.createElement("div");
      el.className = `chat-msg ${who} ${cls}`.trim();
      addText(el, s);
      log.append(el);
      log.scrollTop = log.scrollHeight;
      return el;
    }
    function addLeadButton() {
      const b = document.createElement("button");
      b.type = "button";
      b.className = "btn btn-outline chat-cta";
      b.textContent = "Request a call back";
      b.addEventListener("click", showLead);
      log.append(b);
      log.scrollTop = log.scrollHeight;
    }

    // ---- Open / close and keyboard focus trap ----
    function focusables(): HTMLElement[] {
      const scope = leadBox.hidden ? main : leadBox;
      const sel = 'button:not([disabled]), input:not([disabled]):not([type="hidden"]), select, textarea, a[href], [tabindex="0"]';
      return [panel.querySelector<HTMLElement>("[data-chat-close]")!, ...Array.from(scope.querySelectorAll<HTMLElement>(sel))]
        .filter((el) => !el.closest("[hidden]") && !el.closest(".hidden") && el.tabIndex >= 0);
    }
    function open() {
      panel.hidden = false;
      fab.hidden = true;
      fab.setAttribute("aria-expanded", "true");
      document.documentElement.style.overflow = window.matchMedia("(max-width: 1023px)").matches ? "hidden" : "";
      if (!greeted) { greeted = true; addMessage("bot", d.greeting!); log.scrollTop = 0; }
      text.focus();
    }
    function close() {
      panel.hidden = true;
      fab.hidden = false;
      fab.setAttribute("aria-expanded", "false");
      document.documentElement.style.overflow = "";
      fab.focus();
    }
    function showLead() {
      main.hidden = true; leadBox.hidden = false;
      leadForm.hidden = false; leadDone.hidden = true;
      leadError.textContent = "";
      leadForm.querySelector<HTMLInputElement>("#lead-name")!.focus();
    }
    function showChat() {
      leadBox.hidden = true; main.hidden = false;
      text.focus();
    }
    fab.addEventListener("click", open);
    root.querySelector("[data-chat-close]")!.addEventListener("click", close);
    root.querySelector("[data-chat-lead-open]")!.addEventListener("click", showLead);
    root.querySelectorAll("[data-lead-back]").forEach((b) => b.addEventListener("click", showChat));
    panel.addEventListener("keydown", (e) => {
      if (e.key === "Escape") { e.preventDefault(); close(); return; }
      if (e.key !== "Tab") return;
      const f = focusables();
      if (!f.length) return;
      const first = f[0], last = f[f.length - 1];
      if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }
      else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
    });

    // ---- Sending a message ----
    function unavailable() {
      addMessage("bot", `Sorry, the assistant isn't available right now (this is a demo). Please call ${phoneDisplay}.`);
    }
    async function send(raw: string) {
      const msg = raw.trim();
      if (!msg || busy) return;
      chips.hidden = true;
      if (history.filter((m) => m.role === "user").length >= maxUser) {
        addMessage("bot", `We've reached the limit for this chat. Please call ${phoneDisplay} and we'll be happy to help.`);
        return;
      }
      busy = true; sendBtn.disabled = true;
      addMessage("me", msg);
      history.push({ role: "user", content: msg });
      text.value = "";
      const wait = addMessage("bot", "Typing…", "chat-typing");
      try {
        const res = await fetch(d.endpoint!, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ messages: history }),
        });
        wait.remove();
        if (!res.ok) {
          history.pop();
          if (res.status === 429) addMessage("bot", `You're sending messages quickly. Please wait a moment, or call ${phoneDisplay}.`);
          else unavailable();
          return;
        }
        const data = (await res.json()) as { reply?: string };
        let reply = (data.reply ?? "").trim();
        const wantsLead = reply.includes("[[LEAD]]");
        reply = reply.replace(/\[\[LEAD\]\]/g, "").trim();
        if (!reply) { history.pop(); unavailable(); return; }
        history.push({ role: "assistant", content: reply });
        addMessage("bot", reply);
        if (wantsLead) addLeadButton();
      } catch {
        wait.remove();
        history.pop();
        unavailable();
      } finally {
        busy = false; sendBtn.disabled = false;
        if (!panel.hidden && leadBox.hidden) text.focus();
      }
    }
    form.addEventListener("submit", (e) => { e.preventDefault(); send(text.value); });
    root.querySelectorAll<HTMLButtonElement>("[data-chat-suggest]").forEach((b) =>
      b.addEventListener("click", () => send(b.textContent ?? "")));

    // ---- Lead form (Netlify Form "chat-lead"; on localhost it runs in demo mode and sends nothing) ----
    leadForm.addEventListener("submit", async (e) => {
      e.preventDefault();
      leadError.textContent = "";
      const fd = new FormData(leadForm);
      const name = String(fd.get("name") ?? "").trim();
      const phone = String(fd.get("phone") ?? "").trim();
      const email = String(fd.get("email") ?? "").trim();
      if (!name) { leadError.textContent = "Please enter your name."; leadForm.querySelector<HTMLInputElement>("#lead-name")!.focus(); return; }
      if (!phone && !email) { leadError.textContent = "Please enter a phone number or an email."; leadForm.querySelector<HTMLInputElement>("#lead-phone")!.focus(); return; }
      if (email && !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) { leadError.textContent = "That email doesn't look right."; leadForm.querySelector<HTMLInputElement>("#lead-email")!.focus(); return; }
      leadSubmit.disabled = true; leadSubmit.textContent = "Sending…";
      const local = ["localhost", "127.0.0.1", "[::1]"].includes(location.hostname);
      try {
        if (!local) {
          const body = new URLSearchParams(fd as unknown as Record<string, string>).toString();
          const res = await fetch("/", { method: "POST", headers: { "Content-Type": "application/x-www-form-urlencoded" }, body });
          if (!res.ok) throw new Error(String(res.status));
        }
        leadForm.hidden = true; leadDone.hidden = false; leadForm.reset();
        leadDone.focus();
      } catch {
        leadError.textContent = `Sorry, that didn't go through. Please call ${phoneDisplay}.`;
      } finally {
        leadSubmit.disabled = false; leadSubmit.textContent = "Send";
      }
    });
  }
</script>
