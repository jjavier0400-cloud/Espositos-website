---
// Small shamrock accent (from the logo). Three heart-shaped leaves and a stem.
interface Props { class?: string }
const { class: cls = "" } = Astro.props;
const leaf = "M0 0 C-2 -4 -12 -8 -12 -16 C-12 -22 -4 -24 0 -18 C4 -24 12 -22 12 -16 C12 -8 2 -4 0 0Z";
---
<svg class={cls} viewBox="0 0 64 64" aria-hidden="true" focusable="false" fill="currentColor">
  <g transform="translate(32 30)">
    <path d={leaf} />
    <path d={leaf} transform="rotate(120)" />
    <path d={leaf} transform="rotate(240)" />
  </g>
  <path d="M33 32 C36 42 40 50 46 58" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" />
</svg>
