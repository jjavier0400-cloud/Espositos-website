---
import Base from "../layouts/Base.astro";
import PageHeader from "../components/PageHeader.astro";
import QuoteForm from "../components/QuoteForm.astro";
import OpenStatus from "../components/OpenStatus.astro";
import { seo, business, hours } from "../data/site";
---
<Base title={seo.contact.title} description={seo.contact.description}>
  <PageHeader title="Contact us" intro="Your calls and emails are always welcome. Use the form for products, delivery questions and general inquiries." />
  <section class="bg-frost py-14 md:py-20">
    <div class="wrap grid items-start gap-10 lg:grid-cols-[1fr_1.3fr]">
      <div class="space-y-8" data-reveal>
        <div>
          <h2 class="text-2xl font-bold">Call</h2>
          <a href={`tel:${business.phone.tel}`} class="mt-1 inline-flex min-h-12 items-center font-display text-4xl font-bold text-green no-underline">{business.phone.display}</a>
          <p class="mt-1 font-semibold">24-hour emergency ice delivery. {business.spanishBadge}.</p>
        </div>
        <div>
          <h2 class="text-2xl font-bold">Visit</h2>
          <address class="mt-1 not-italic text-lg">{business.address.street}<br />{business.address.city}, {business.address.state} {business.address.zip}</address>
          <a href={business.address.mapsUrl} class="mt-1 inline-flex min-h-11 items-center font-semibold underline decoration-tan decoration-2 underline-offset-4" target="_blank" rel="noopener">Get directions</a>
        </div>
        <div>
          <h2 class="text-2xl font-bold">Hours</h2>
          <p class="mt-2"><OpenStatus variant="inline" /></p>
          <dl class="mt-3 max-w-sm space-y-1">
            {hours.summary.map((h) => (<div class="flex justify-between gap-6 border-b border-line py-1.5"><dt>{h.days}</dt><dd class="font-semibold">{h.time}</dd></div>))}
          </dl>
        </div>
      </div>
      <div data-reveal style="--i:1"><QuoteForm /></div>
    </div>
  </section>
</Base>
