---
import { reviews, business } from "../data/site";
---
<section class="py-16 md:py-24" aria-labelledby="reviews-h">
  <div class="wrap">
    <div data-reveal>
      <span class="kicker-rule"></span>
      <h2 id="reviews-h" class="text-4xl font-bold md:text-5xl">What customers say</h2>
    </div>
    <div class="mt-10 grid gap-8 md:grid-cols-2">
      {reviews.map((r, i) => (
        <figure class="border-l-4 border-tan pl-6" data-reveal style={`--i:${i}`}>
          <p class="font-display text-xl font-bold text-green">{r.title}</p>
          <blockquote class="mt-3 font-display text-2xl leading-snug md:text-[1.7rem]">“{r.quote}”</blockquote>
          <figcaption class="mt-4 font-semibold text-muted">{r.author}, {r.source}</figcaption>
        </figure>
      ))}
    </div>
    <a href={business.social.googleReviews} class="mt-10 inline-flex min-h-11 items-center font-semibold underline decoration-tan decoration-2 underline-offset-4" target="_blank" rel="noopener">Read our reviews on Google</a>
  </div>
</section>
