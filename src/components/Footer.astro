---
import { business, hours, products } from "../data/site";
import Shamrock from "./Shamrock.astro";
const year = new Date().getFullYear();
---
<footer class="on-dark bg-green text-white">
  <div class="wrap grid gap-10 py-14 md:grid-cols-2 lg:grid-cols-4">
    <div>
      <p class="font-display text-2xl font-bold">{business.name}</p>
      <p class="mt-3 text-white">Serving New Jersey since {business.since}.</p>
      <p class="mt-4 inline-block rounded-full bg-white px-3 py-1 text-sm font-bold text-green">{business.spanishBadge}</p>
    </div>
    <div>
      <h2 class="text-lg font-bold">Visit</h2>
      <address class="mt-3 not-italic text-white">{business.address.street}<br />{business.address.city}, {business.address.state} {business.address.zip}</address>
      <a class="mt-2 inline-flex min-h-11 items-center font-semibold text-white underline underline-offset-4" href={business.address.mapsUrl} target="_blank" rel="noopener">Get directions</a>
    </div>
    <div>
      <h2 class="text-lg font-bold">Hours</h2>
      <dl class="mt-3 space-y-1 text-white">
        {hours.summary.map((h) => (<div class="flex justify-between gap-4"><dt>{h.days}</dt><dd>{h.time}</dd></div>))}
      </dl>
      <p class="mt-3 text-sm text-white">24-hour emergency ice delivery.</p>
    </div>
    <div>
      <h2 class="text-lg font-bold">Call or follow</h2>
      <a href={`tel:${business.phone.tel}`} class="mt-3 inline-flex min-h-11 items-center font-display text-2xl font-bold text-white no-underline">{business.phone.display}</a>
      <ul class="mt-2 flex gap-2">
        <li><a class="social" href={business.social.instagram} target="_blank" rel="noopener">Instagram</a></li>
        <li><a class="social" href={business.social.facebook} target="_blank" rel="noopener">Facebook</a></li>
      </ul>
    </div>
  </div>
  <div class="wrap">
    <div class="flex items-center gap-4 text-tan" aria-hidden="true">
      <span class="h-px flex-1 bg-white/25"></span>
      <Shamrock class="h-7 w-7" />
      <span class="h-px flex-1 bg-white/25"></span>
    </div>
    <div class="flex flex-col gap-2 py-6 text-sm text-white md:flex-row md:justify-between">
      <p>© {year} {business.name}. All rights reserved.</p>
      <ul class="flex flex-wrap gap-x-4">
        <li><a class="inline-flex min-h-11 items-center text-white" href={`/ice-products/#${products.dry.id}`}>Dry ice</a></li>
        <li><a class="inline-flex min-h-11 items-center text-white" href="/freezer-rental/">Freezer rental</a></li>
        <li><a class="inline-flex min-h-11 items-center text-white" href="/contact-us/">Contact</a></li>
      </ul>
    </div>
  </div>
</footer>
<style>
  .social { display: inline-flex; align-items: center; min-height: 44px; padding: 0 0.9rem; border-radius: 999px; box-shadow: inset 0 0 0 2px rgb(255 255 255 / 0.6); color: #fff; font-weight: 600; text-decoration: none; }
  .social:hover { background: rgb(255 255 255 / 0.12); }
</style>
