---
// Sizes table. Shows a Price column only if at least one row has a price in site.ts.
import type { SpecRow } from "../data/site";
interface Props { rows: SpecRow[]; caption: string; note?: string }
const { rows, caption, note } = Astro.props;
const hasPrices = rows.some((r) => r.price);
---
<div>
  <table class="spec">
    <caption class="sr-only">{caption}</caption>
    <thead class="sr-only"><tr><th scope="col">Item</th><th scope="col">Size</th>{hasPrices && <th scope="col">Price</th>}</tr></thead>
    <tbody>
      {rows.map((r) => (
        <tr>
          <th scope="row">{r.item}</th>
          <td>{r.detail}{r.note && <span class="mt-0.5 block text-sm font-semibold text-ink">{r.note}</span>}</td>
          {hasPrices && <td>{r.price ?? "Call"}</td>}
        </tr>
      ))}
    </tbody>
  </table>
  {note && <p class="mt-3 text-sm text-muted">{note}</p>}
</div>
