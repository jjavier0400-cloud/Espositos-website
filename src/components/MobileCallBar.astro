---
// Always-visible bar on phones and tablets: tap to call, or go to the quote form.
import { business } from "../data/site";
---
<div class="callbar fixed inset-x-0 bottom-0 z-50 border-t border-line bg-white/97 backdrop-blur lg:hidden">
  <div class="wrap flex gap-2 py-2.5">
    <a href={`tel:${business.phone.tel}`} class="btn btn-primary flex-auto whitespace-nowrap px-3 text-base" data-call-link>
      <svg class="max-[399px]:hidden" width="20" height="20" viewBox="0 0 24 24" aria-hidden="true" fill="currentColor"><path d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25 11.4 11.4 0 0 0 3.6.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.45.57 3.57a1 1 0 0 1-.25 1L6.6 10.8z"/></svg>
      Call {business.phone.display}
    </a>
    <a href="/contact-us/#quote" class="btn btn-outline flex-auto whitespace-nowrap px-3 text-base">Get a quote</a>
  </div>
</div>
<style>
  .callbar { padding-bottom: env(safe-area-inset-bottom); }
</style>
